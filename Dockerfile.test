# syntax=docker/dockerfile:1
FROM alpine:3.22

ARG XRAY_VERSION=v26.3.27
ARG XRAY_ASSET_SHA256=23cd9af937744d97776ee35ecad4972cf4b2109d1e0fe6be9930467608f7c8ae

RUN apk add --no-cache \
      bash \
      ca-certificates \
      coreutils \
      curl \
      jq \
      openssl \
      shellcheck \
      unzip \
    && curl -fsSL \
      "https://github.com/XTLS/Xray-core/releases/download/${XRAY_VERSION}/Xray-linux-64.zip" \
      -o /tmp/xray.zip \
    && printf '%s  %s\n' "${XRAY_ASSET_SHA256}" /tmp/xray.zip | sha256sum -c - \
    && unzip -jq /tmp/xray.zip xray -d /usr/local/bin \
    && chmod 0755 /usr/local/bin/xray \
    && rm -f /tmp/xray.zip

WORKDIR /workspace
COPY . .

ENV XRAY_BIN=/usr/local/bin/xray

CMD ["bash", "tests/run_all.sh"]
